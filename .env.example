# === Base de datos (Postgres en contenedor) ===
POSTGRES_DB=salonevents
POSTGRES_USER=salon
POSTGRES_PASSWORD=cambia-esta-contraseña

# Cadena de conexión Npgsql del backend hacia el contenedor `db`.
# En docker-compose el host es el nombre del servicio: `db`.
DATABASE_URL=Host=db;Port=5432;Database=salonevents;Username=salon;Password=cambia-esta-contraseña

# === Autenticación propia (backend) ===
# Secreto para firmar los JWT (HS256). Genera uno con: openssl rand -base64 48
JWT_SECRET=
JWT_ISSUER=salonevents
JWT_AUDIENCE=salonevents-app

# Primer admin sembrado al arrancar (idempotente; no se re-crea si ya existe).
ADMIN_EMAIL=admin@ejemplo.com
ADMIN_PASSWORD=cambia-esta-contraseña

# Origen del frontend permitido por CORS.
FRONTEND_ORIGIN=http://localhost:8080

# === Frontend (Vite) — valor público, se hornea en el build ===
VITE_API_URL=http://localhost:5080
