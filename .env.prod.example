# .env.prod.example
# Copia este fichero a `.env` EN EL VPS, junto a docker-compose.prod.yml.
# Docker Compose carga `.env` automaticamente (no hace falta --env-file).
# NO lo versiones (esta cubierto por .gitignore / .dockerignore).

# === Imagen publicada (Docker Hub) ===
DOCKERHUB_USER=miusuario
# Tag que quieres desplegar (el mismo que pasaste a scripts/build-push.ps1).
TAG=v1

# === Traefik (ya existente en tu VPS) ===
# Nombre EXACTO de la red externa de Traefik. Compruebalo con: docker network ls
TRAEFIK_NETWORK=traefik
# Nombre del certresolver definido en tu Traefik (Let's Encrypt).
TRAEFIK_CERTRESOLVER=letsencrypt
# Dominio publico UNICO que apunta al VPS (registro A/AAAA).
# El frontend se sirve aqui y /api se proxea al backend (mismo origen).
WEB_DOMAIN=tudominio.com

# === Base de datos (Postgres en contenedor) ===
POSTGRES_DB=salonevents
POSTGRES_USER=salon
POSTGRES_PASSWORD=cambia-esta-contrasena-fuerte

# === Backend (runtime) ===
# Misma base/usuario/contrasena de arriba; el host es el servicio `db`.
DATABASE_URL=Host=db;Port=5432;Database=salonevents;Username=salon;Password=cambia-esta-contrasena-fuerte
# Secreto para firmar los JWT (HS256). Genera uno: openssl rand -base64 48
JWT_SECRET=
JWT_ISSUER=salonevents
JWT_AUDIENCE=salonevents-app
# Primer admin sembrado al arrancar (idempotente).
ADMIN_EMAIL=admin@ejemplo.com
ADMIN_PASSWORD=cambia-esta-contrasena
# Origen permitido por CORS = URL PUBLICA del frontend (https).
# Con el proxy /api es el MISMO origen, asi que basta con el dominio publico.
FRONTEND_ORIGIN=https://tudominio.com

# === Contacto por WhatsApp (config publica de runtime) ===
# El backend expone estos valores en GET /api/config y el frontend los lee al
# arrancar. Para cambiar el numero NO hay que reconstruir el frontend: edita
# estas variables y reinicia (docker compose up -d).
# Telefono destino en formato internacional, SOLO digitos (sin +, espacios ni
# guiones). Ej. Mexico: 521234567890. Vacio = el contacto no se ofrece.
WHATSAPP_PHONE=
# Mensaje predeterminado; admite el marcador {fecha}, sustituido por la fecha
# seleccionada. La app solo PREPARA el mensaje en WhatsApp; no lo envia.
WHATSAPP_MESSAGE=Hola, me interesa el salon para el dia {fecha}. Esta disponible?

# === NOTA sobre VITE_API_URL ===
# NO se define aqui NI se hornea en la imagen. El frontend usa rutas relativas
# (/api/...) y nginx las proxea al backend por la red interna (mismo origen).
# Por eso la imagen frontend es generica y NO hay que reconstruirla si cambia
# el dominio: solo actualizas WEB_DOMAIN / FRONTEND_ORIGIN y reinicias.
