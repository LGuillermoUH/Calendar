<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SalonEvents.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
  </ItemGroup>

  <!-- El esquema SQL vive en ../db/schema.sql; se copia a la salida (db/schema.sql)
       para ejecutarlo al arrancar (DbInitializer crea tablas/triggers si no existen). -->
  <ItemGroup>
    <Content Include="..\db\schema.sql" Link="db\schema.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
