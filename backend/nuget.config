<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Aísla la restauración de paquetes de este backend al feed público nuget.org,
       evitando feeds privados configurados globalmente que requieren autenticación. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
